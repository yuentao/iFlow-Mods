{
  "version": "1.0.0",
  "requestOverrides": [
    {
      "pattern": "^kimi-k3(?:$|[-.:])",
      "set": {
        "temperature": 1,
        "top_p": 0.95,
        "presence_penalty": 0,
        "frequency_penalty": 0
      },
      "delete": [
        "thinking"
      ],
      "setIfMissing": {
        "reasoning_effort": "max"
      }
    }
  ]
}
