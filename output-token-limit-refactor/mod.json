  "repository": "",
  "license": "MIT",
  "include": [
    "output-token-limit-loader.cjs",
    "output-token-limits.json"
  ],
  "includeMap": {
    "output-token-limit-loader.cjs": "core",
    "output-token-limits.json": "~/.iflow"
  },
